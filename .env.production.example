# Production Environment Configuration
# This is an EXAMPLE file - DO NOT use directly in production
# Copy to .env and update ALL values with production-specific settings

# ==========================================
# APPLICATION SETTINGS
# ==========================================
APP_NAME="Surat App"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# IMPORTANT: Generate a unique key using: docker-compose exec app php artisan key:generate
APP_KEY=base64:your_production_key_must_be_generated_securely

# Your domain/IP address
APP_URL=https://yourdomain.com

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=surat_prod_db
DB_USERNAME=surat_prod_user
DB_PASSWORD=your_very_secure_database_password_min_32_chars
DB_ROOT_PASSWORD=your_very_secure_root_password_min_32_chars

# Optional: Connection pool for high traffic
# DB_POOL_SIZE=10
# DB_POOL_IDLE=60

# ==========================================
# REDIS CACHE & SESSION
# ==========================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_min_32_chars

CACHE_STORE=redis
CACHE_PREFIX=surat_app_prod
CACHE_DEFAULT_TTL=3600

# ==========================================
# SESSION MANAGEMENT
# ==========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE=true
SESSION_SAME_SITE=strict

# ==========================================
# QUEUE & JOBS
# ==========================================
QUEUE_CONNECTION=redis
QUEUE_NAME=default

# ==========================================
# FILE STORAGE
# ==========================================
FILESYSTEM_DISK=local
FILESYSTEM_VISIBILITY=public

# For S3 or other cloud storage (optional):
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=your-bucket-name
# AWS_URL=https://bucket.s3.amazonaws.com

# ==========================================
# MAIL CONFIGURATION
# ==========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@domain.com
MAIL_FROM_NAME="${APP_NAME}"

# Alternative: Use SendGrid
# MAIL_MAILER=sendgrid
# SENDGRID_API_KEY=your_sendgrid_key

# ==========================================
# LOGGING
# ==========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=notice
LOG_DEPRECATIONS_CHANNEL=null

# Maximum log file size in MB
LOG_MAX_SIZE=100

# Days to retain logs
LOG_RETENTION_DAYS=14

# ==========================================
# BROADCAST
# ==========================================
BROADCAST_DRIVER=log
# BROADCAST_DRIVER=pusher
# PUSHER_APP_ID=your_pusher_id
# PUSHER_APP_KEY=your_pusher_key
# PUSHER_APP_SECRET=your_pusher_secret

# ==========================================
# DOCKER PORTS (expose from docker-compose)
# ==========================================
NGINX_PORT=80
NGINX_HTTPS_PORT=443
DB_PORT=3306
REDIS_PORT=6379

# ==========================================
# SECURITY
# ==========================================
# HTTPS redirect
FORCE_HTTPS=true

# Password hashing
BCRYPT_ROUNDS=12

# ==========================================
# MISCELLANEOUS
# ==========================================
MAINTENANCE_DRIVER=file
MAINTENANCE_STORE=file

PHP_CLI_SERVER_WORKERS=4

# Application maintenance mode file path
# MAINTENANCE_STORE_PATH=storage/framework/maintenance.json

# ==========================================
# HEALTH CHECK
# ==========================================
# Seed database on first run
SEED_DATABASE=false

# ==========================================
# MONITORING & PERFORMANCE
# ==========================================
# Enable query logging for slow queries (development only)
# DB_LOG_QUERIES=true
# DB_SLOW_QUERIES_THRESHOLD=1000

# New Relic monitoring (optional)
# NEW_RELIC_ENABLED=true
# NEW_RELIC_APP_NAME="Surat App"
# NEW_RELIC_LICENSE_KEY=your_key

# Sentry error tracking (optional)
# SENTRY_LARAVEL_DSN=your_sentry_dsn
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ==========================================
# IMPORTANT: BEFORE DEPLOYING
# ==========================================
# 1. Replace ALL values marked with 'your_'
# 2. Generate unique APP_KEY:
#    docker-compose exec app php artisan key:generate --show
# 3. Use strong passwords (minimum 32 characters)
# 4. Setup SSL/HTTPS certificate
# 5. Test thoroughly before going live
# 6. Setup automated backups
# 7. Configure monitoring and alerts
# 8. Test failover and recovery procedures
